# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=synapse_db
POSTGRES_TEST_DB=synapse_test
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/synapse_db
# Pytest only — truncates this DB, never synapse_db (uvicorn / Swagger).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/synapse_test

# JWT settings
SECRET_KEY=your-very-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SALT_ROUNDS=12
